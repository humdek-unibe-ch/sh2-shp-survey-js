            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::restoreVersion",
            "methods": [
                "POST"
            ],
            "requirements": {
                "id": "\\d+",
                "versionId": "\\d+"
            },
            "permission": "surveyjs.survey.publish"
        },
        {
            "name": "surveyjs_admin_versions_get",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}/versions/{versionId}",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::getVersion",
            "methods": [
                "GET"
            ],
            "requirements": {
                "id": "\\d+",
                "versionId": "\\d+"
            },
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
