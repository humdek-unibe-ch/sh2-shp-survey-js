        },
        {
            "name": "surveyjs_admin_response_pdf",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}/responses/{rid}/pdf",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::responsePdf",
            "methods": [
                "GET"
            ],
            "requirements": {
                "id": "\\d+",
                "rid": "[A-Za-z0-9_-]+"
            },
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
            ]
        },
        {
            "name": "surveyjs_admin_license_key",
            "path": "/admin/plugins/sh2-shp-survey-js/license-key",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysLicenseController::__invoke",
            "methods": [
                "GET"
            ],
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
            ]
        },
