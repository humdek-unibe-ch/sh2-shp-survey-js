            "methods": [
                "POST"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permissions": [
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
            ]
        },
        {
            "name": "surveyjs_admin_dashboard",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}/dashboard",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::dashboard",
            "methods": [
                "GET"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
            ]
        },
        {
            "name": "surveyjs_admin_dashboard_results",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}/dashboard/results",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::dashboardResults",
            "methods": [
                "GET"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
            ]
        },
        {
            "name": "surveyjs_admin_response_detail",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}/responses/{rid}",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::responseDetail",
            "methods": [
                "GET"
            ],
            "requirements": {
                "id": "\\d+",
                "rid": "[A-Za-z0-9_-]+"
            },
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
