{
    "id": "sh2-shp-survey-js",
    "name": "SurveyJS",
    "description": "SurveyJS v3 integration for SelfHelp CMS. Provides a Mantine-themed Survey Creator (admin), a survey runtime style, and a public submission pipeline that writes into the existing data_tables / data_rows / data_cells. Includes optional GPX, Video, and rich-text custom question types.",
    "version": "0.3.4",
    "pluginApiVersion": "0.1.0",
    "author": {
        "name": "Humdek, University of Bern",
        "email": "selfhelp@unibe.ch",
        "url": "https://github.com/humdek-unibe-ch"
    },
    "license": "MPL-2.0",
    "homepage": "https://github.com/humdek-unibe-ch/sh2-shp-survey-js",
    "compatibility": {
        "selfhelp": ">=0.1.0",
        "php": "^8.4",
        "node": "^22",
        "react": "^19",
        "reactNative": "^0.83",
        "expoSdk": "^55",
        "mobile": ">=0.2.0"
    },
    "dependencies": [],
    "conflicts": [
        {
            "pluginId": "sh-shp-survey_js",
            "version": "*",
            "reason": "Replaced by SurveyJS v2 (sh2-shp-survey-js)."
        }
    ],
    "backend": {
        "bundleClass": "Humdek\\SurveyJsBundle\\HumdekSurveyJsBundle",
        "migrationsNamespace": "Humdek\\SurveyJsBundle\\Migrations",
        "composer": {
            "package": "humdek/sh2-shp-survey-js",
            "version": "0.3.4",
            "repository": {
                "type": "vcs",
                "url": "https://github.com/humdek-unibe-ch/sh2-shp-survey-js.git"
            }
        }
    },
    "frontend": {
        "runtime": {
            "entrypoint": "dist/plugin.esm.js",
            "stylesheet": "dist/plugin.css",
            "format": "esm",
            "devEntrypointUrl": "http://localhost:5174/sh2-shp-survey-js/plugin.esm.js"
        }
    },
    "mobile": {
        "package": "@selfhelp/sh2-shp-survey-js-mobile",
        "version": "0.3.4",
        "readonly": false
    },
    "security": {
        "trustLevel": "official",
        "capabilities": [
            "backendBundle",
            "databaseMigrations",
            "readDataTables",
            "writeDataTables",
            "lookupOwnGroup",
            "lookupExtend",
            "frontendStyles",
            "mobileStyles",
            "adminPages",
            "realtimePublish",
            "secretAccess"
        ],
        "cspRules": {
            "img-src": [
                "https://*.tile.openstreetmap.org",
                "https://*.basemaps.cartocdn.com"
            ]
        },
        "externalHosts": [
            {
                "host": "*.tile.openstreetmap.org",
                "type": "image",
                "reason": "Leaflet tile layers used by the GPX question type preview."
            },
            {
                "host": "*.basemaps.cartocdn.com",
                "type": "image",
                "reason": "Fallback basemap tiles for the GPX preview."
            }
        ],
        "signing": {
            "required": false
        }
    },
    "permissions": [
        {
            "key": "surveyjs.survey.read",
            "description": "Open the SurveyJS admin screens and see the surveys the role has the view grant on. Their answers also need the grant on the survey's data table.",
            "defaultRoles": [
                "admin"
            ]
        },
        {
            "key": "surveyjs.survey.create",
            "description": "Create surveys. The creator's roles that hold this permission get all four rights on the new survey.",
            "defaultRoles": [
                "admin"
            ]
        },
        {
            "key": "surveyjs.survey.update",
            "description": "Edit the surveys a role has the update grant on (Creator, settings, versions). Their dashboard and responses also need the grant on the survey's data table.",
            "defaultRoles": [
                "admin"
            ]
        },
        {
            "key": "surveyjs.survey.publish",
            "description": "Publish or restore a version of a survey the role has the update grant on.",
            "defaultRoles": [
                "admin"
            ]
        },
        {
            "key": "surveyjs.survey.delete",
            "description": "Delete the surveys a role has the delete grant on.",
            "defaultRoles": [
                "admin"
            ]
        }
    ],
    "dataAccess": {
        "ownedTables": [
            "survey_answer_links",
            "survey_files",
            "survey_response_drafts",
            "survey_runs",
            "survey_versions",
            "surveys"
        ],
        "ownedDataTablePrefix": "sh2_surveyjs_",
        "read": [
            "data_tables",
            "data_rows",
            "data_cols",
            "data_cells",
            "lookups",
            "languages"
        ],
        "write": [
            "data_tables",
            "data_rows",
            "data_cols",
            "data_cells"
        ]
    },
    "realtimeTopics": [
        {
            "key": "surveys/{surveyId}/responses",
            "description": "Realtime stream of new survey responses. New entries arrive without polling.",
            "requiredPermission": "surveyjs.survey.read"
        },
        {
            "key": "surveys/{surveyId}/editing",
            "description": "Collaborative-edit presence + save notifications for the Survey Creator.",
            "requiredPermission": "surveyjs.survey.update"
        }
    ],
    "featureFlags": [
        {
            "key": "gpx",
            "description": "Enable GPX track question type.",
            "defaultEnabled": false
        },
        {
            "key": "video",
            "description": "Enable video question type.",
            "defaultEnabled": false
        },
        {
            "key": "microphone",
            "description": "Enable microphone (audio recording) question type.",
            "defaultEnabled": false
        },
        {
            "key": "rich-text",
            "description": "Enable Tiptap-based rich-text question + Creator property editors.",
            "defaultEnabled": true
        },
        {
            "key": "pdf-export",
            "description": "Enable PDF export of survey responses.",
            "defaultEnabled": false
        },
        {
            "key": "dashboard",
            "description": "Enable response dashboard view.",
            "defaultEnabled": true
        },
        {
            "key": "collab-editing",
            "description": "Enable collaborative-edit Mercure notifications in the Creator.",
            "defaultEnabled": true
        }
    ],
    "lookups": {
        "extends": [
            {
                "typeCode": "surveyJsTheme",
                "ownership": "plugin_owned",
                "entries": [
                    {
                        "code": "default",
                        "value": "Default",
                        "description": "Mantine-bridged default theme."
                    },
                    {
                        "code": "modern",
                        "value": "Modern"
                    },
                    {
                        "code": "high-contrast",
                        "value": "High contrast"
                    }
                ]
            },
            {
                "typeCode": "resourceTypes",
                "ownership": "plugin_extendable",
                "entries": [
                    {
                        "code": "surveyjs_survey",
                        "value": "Surveys",
                        "description": "SurveyJS surveys: who may see, edit, publish and delete each survey."
                    }
                ]
            }
        ]
    },
    "styleGroups": [
        {
            "name": "Plugin: SurveyJS",
            "description": "Styles of the SurveyJS plugin."
        }
    ],
    "fieldTypes": [
        {
            "name": "select-survey-js",
            "position": 8
        }
    ],
    "fields": [
        {
            "name": "survey_js",
            "type": "select-survey-js",
            "renamedFrom": [
                "survey-js"
            ]
        },
        {
            "name": "sample_points",
            "type": "json"
        },
        {
            "name": "restart_on_refresh",
            "type": "checkbox"
        },
        {
            "name": "once_per_user",
            "type": "checkbox"
        },
        {
            "name": "once_per_schedule",
            "type": "checkbox"
        },
        {
            "name": "save_pdf",
            "type": "checkbox"
        },
        {
            "name": "url_params",
            "type": "checkbox"
        },
        {
            "name": "start_time",
            "type": "time"
        },
        {
            "name": "end_time",
            "type": "time"
        },
        {
            "name": "auto_save_interval",
            "type": "number"
        },
        {
            "name": "label_survey_done",
            "type": "markdown-inline",
            "translatable": true
        },
        {
            "name": "label_survey_not_active",
            "type": "markdown-inline",
            "translatable": true
        },
        {
            "name": "label_survey_timeout",
            "type": "markdown-inline",
            "translatable": true
        },
        {
            "name": "label_login_required",
            "type": "markdown-inline",
            "translatable": true
        },
        {
            "name": "label_loading",
            "type": "text",
            "translatable": true
        },
        {
            "name": "label_submitting",
            "type": "text",
            "translatable": true
        },
        {
            "name": "btn_new_response_label",
            "type": "text",
            "translatable": true
        },
        {
            "name": "timeout",
            "type": "number"
        },
        {
            "name": "allow_anonymous",
            "type": "checkbox"
        },
        {
            "name": "update_based_on",
            "type": "text"
        },
        {
            "name": "auto_session_key",
            "type": "checkbox"
        }
    ],
    "styles": [
        {
            "name": "surveyjs",
            "description": "Embeds a published SurveyJS survey at runtime. Grouped under the 'Plugin: SurveyJS' style_groups row created by the plugin's migration.",
            "canHaveChildren": false,
            "capability": "frontendStyles",
            "group": "Plugin: SurveyJS",
            "fields": [
                {
                    "name": "survey_js",
                    "title": "Survey",
                    "help": "Select the SurveyJS survey to render on this section. The section stores the survey id and the runtime resolves the published survey key automatically.",
                    "default": ""
                },
                {
                    "name": "own_entries_only",
                    "title": "Own Entries Only",
                    "help": "When enabled, only the participant who originally submitted a response can resume / edit it.",
                    "default": "0"
                },
                {
                    "name": "redirect_at_end",
                    "title": "Redirect At End",
                    "help": "Redirect to this URL once the survey is submitted."
                },
                {
                    "name": "close_modal_on_save",
                    "title": "Close Popup On Save",
                    "default": "0",
                    "help": "If the page is shown in a popup, close it after the survey is submitted, like a form does."
                },
                {
                    "name": "restart_on_refresh",
                    "title": "Restart on Refresh",
                    "help": "If checked the survey is restarted on every page refresh.",
                    "default": "0"
                },
                {
                    "name": "once_per_user",
                    "title": "Once Per User",
                    "help": "If checked the survey can be done only once per user. Overrides `once_per_schedule`.",
                    "default": "0"
                },
                {
                    "name": "once_per_schedule",
                    "title": "Once Per Schedule",
                    "help": "If checked the survey can be done at most once per active schedule window. Ignored when `once_per_user` is checked.",
                    "default": "0"
                },
                {
                    "name": "save_pdf",
                    "title": "Save as PDF",
                    "help": "If checked, the user can download the completed survey as a PDF.",
                    "default": "0"
                },
                {
                    "name": "url_params",
                    "title": "URL Parameters",
                    "help": "If enabled, query-string parameters are passed into the survey (e.g. `?par1=2&par2=3`).",
                    "default": "0"
                },
                {
                    "name": "start_time",
                    "title": "Start Time",
                    "help": "Start time when the survey becomes available.",
                    "default": "00:00"
                },
                {
                    "name": "end_time",
                    "title": "End Time",
                    "help": "End time when the survey is no longer available.",
                    "default": "00:00"
                },
                {
                    "name": "auto_save_interval",
                    "title": "Auto-Save Interval (s)",
                    "help": "If higher than 0, the runtime auto-saves the survey every N seconds.",
                    "default": "0"
                },
                {
                    "name": "label_survey_done",
                    "title": "Label - Survey Done",
                    "help": "Shown instead of the survey when the participant already answered and once per user or once per schedule blocks another answer. Empty: nothing is shown."
                },
                {
                    "name": "label_survey_not_active",
                    "title": "Label - Survey Not Active",
                    "help": "Shown instead of the survey outside its start and end time. Empty: nothing is shown."
                },
                {
                    "name": "label_survey_timeout",
                    "title": "Label - Survey Timeout",
                    "help": "Shown when the time set in Timeout is over. Empty: nothing is shown."
                },
                {
                    "name": "label_login_required",
                    "title": "Label - Login Required",
                    "help": "Shown instead of the survey to a visitor who is not signed in, when anonymous answers are not allowed. Empty: nothing is shown."
                },
                {
                    "name": "label_loading",
                    "title": "Label - Loading",
                    "help": "Shown next to the spinner while the survey loads. Empty: nothing is shown."
                },
                {
                    "name": "label_submitting",
                    "title": "Label - Submitting",
                    "help": "Shown next to the spinner while the answers are sent. Empty: nothing is shown."
                },
                {
                    "name": "alert_success_title",
                    "title": "Success Title",
                    "help": "Title of the message shown after the survey is submitted, like a form's. Empty: nothing is shown."
                },
                {
                    "name": "alert_success",
                    "title": "Success Message",
                    "help": "Text of the message shown after the survey is submitted, like a form's. Empty: nothing is shown."
                },
                {
                    "name": "alert_error_title",
                    "title": "Error Title",
                    "help": "Title shown when the answers could not be sent. Empty: a default title is shown, so the participant always knows."
                },
                {
                    "name": "alert_error",
                    "title": "Error Message",
                    "help": "Text shown when the answers could not be sent. Empty: a default text is shown, so the participant always knows."
                },
                {
                    "name": "btn_new_response_label",
                    "title": "Button - New Response",
                    "help": "Label of the button that starts a new response after submitting. Never shown when once per user or once per schedule is on. Empty: nothing is shown."
                },
                {
                    "name": "timeout",
                    "title": "Timeout (minutes)",
                    "help": "Survey expires after N minutes from when the participant started it. Set to 0 to disable.",
                    "default": "0"
                },
                {
                    "name": "allow_anonymous",
                    "title": "Allow Anonymous",
                    "help": "When enabled, the survey may be submitted by unauthenticated visitors. Once-per-user is then enforced by the signed visitor cookie.",
                    "default": "1"
                },
                {
                    "name": "update_based_on",
                    "title": "Update Based On",
                    "help": "Name of a column that identifies the response row; its value comes from the URL parameter of the same name. A participant who opens the link again continues or edits that row instead of starting a new one."
                },
                {
                    "name": "auto_session_key",
                    "title": "Auto Session Key",
                    "default": "0",
                    "help": "Give each guest a private key in the link, so guests who share one invite link do not see each other's answers and can continue on another device. The link works as a password."
                }
            ]
        },
        {
            "name": "gpx-map",
            "description": "Draws a route on a map from sample points: a list of points, a whole GPX answer, or a variable resolving to either.",
            "canHaveChildren": false,
            "capability": "frontendStyles",
            "renamedFrom": [
                "gpxMap"
            ],
            "group": "Plugin: SurveyJS",
            "fields": [
                {
                    "name": "sample_points",
                    "title": "Sample Points",
                    "help": "Inline GPX sample points or a reference to a GPX answer field (`{{question_name}}`). Renders the polyline on the Leaflet map."
                }
            ]
        }
    ],
    "adminPages": [
        {
            "slug": "surveys",
            "label": "SurveyJS",
            "permission": "surveyjs.survey.read",
            "icon": "tabler-clipboard-list"
        }
    ],
    "apiRoutes": [
        {
            "name": "surveyjs_admin_list",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::list",
            "methods": [
                "GET"
            ],
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
            ]
        },
        {
            "name": "surveyjs_admin_create",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::create",
            "methods": [
                "POST"
            ],
            "permission": "surveyjs.survey.create"
        },
        {
            "name": "surveyjs_admin_get",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::get",
            "methods": [
                "GET"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
            ]
        },
        {
            "name": "surveyjs_admin_update",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::update",
            "methods": [
                "PUT"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permission": "surveyjs.survey.update"
        },
        {
            "name": "surveyjs_admin_delete",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::delete",
            "methods": [
                "DELETE"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permission": "surveyjs.survey.delete"
        },
        {
            "name": "surveyjs_admin_draft_save",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}/draft",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::saveDraft",
            "methods": [
                "PUT"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permission": "surveyjs.survey.update"
        },
        {
            "name": "surveyjs_admin_versions_create",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}/versions",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::publishVersion",
            "methods": [
                "POST"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permission": "surveyjs.survey.publish"
        },
        {
            "name": "surveyjs_admin_versions_list",
            "path": "/admin/plugins/sh2-shp-survey-js/surveys/{id}/versions",
            "controller": "Humdek\\SurveyJsBundle\\Controller\\Api\\V1\\SurveysAdminController::versions",
            "methods": [
                "GET"
            ],
            "requirements": {
                "id": "\\d+"
            },
            "permissions": [
                "surveyjs.survey.read",
                "surveyjs.survey.create",
                "surveyjs.survey.update",
                "surveyjs.survey.publish",
                "surveyjs.survey.delete"
            ]
        },
        {
            "name": "surveyjs_admin_versions_restore",
